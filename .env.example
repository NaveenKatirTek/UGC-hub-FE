# Environment Variables Template
# Copy this file to .env and fill in your values

# API Configuration
VITE_API_URL=http://localhost:5000/api

# Application Configuration
VITE_APP_NAME=BrandCreator Connect
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# Optional: Google OAuth (if implementing social login)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Optional: Facebook OAuth (if implementing social login)
# VITE_FACEBOOK_APP_ID=your_facebook_app_id_here

# Optional: Analytics (if implementing)
# VITE_GA_TRACKING_ID=your_google_analytics_id_here

# Optional: File Upload Configuration
# VITE_MAX_FILE_SIZE=5242880
# VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Optional: Feature Flags
# VITE_ENABLE_SOCIAL_LOGIN=false
# VITE_ENABLE_EMAIL_VERIFICATION=true
# VITE_ENABLE_MOBILE_VERIFICATION=true
